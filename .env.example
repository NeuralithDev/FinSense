# ============================================================
# FinSense — Environment Variables Template
# ============================================================
# Copy to .env and fill in real values.  .env is gitignored.
#
#   cp .env.example .env

# ── AI Provider ──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Local LLM (Ollama) ────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Compute ──────────────────────────────────────────────────
# CUDA_VISIBLE_DEVICES=0

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false
